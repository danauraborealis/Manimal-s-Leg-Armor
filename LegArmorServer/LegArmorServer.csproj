<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Library</OutputType>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>annotations</Nullable>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <RootNamespace>LegArmorMod</RootNamespace>
    <AssemblyName>LegArmorServer</AssemblyName>
    <Company>$(ModAuthor)</Company>
    <Product>$(ModServerName)</Product>
    <Version>$(ModVersion)</Version>
    <Description>Server-side mod for LegArmor</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <SptPackageServerDirectory Condition="'$(SptPackageServerDirectory)' == ''">SPT_Runtime</SptPackageServerDirectory>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(SptServerRoot)\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Common"><HintPath>$(SptServerRoot)\SPTarkov.Common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.DI"><HintPath>$(SptServerRoot)\SPTarkov.DI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Reflection"><HintPath>$(SptServerRoot)\SPTarkov.Reflection.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SPTarkov.Server.Core"><HintPath>$(SptServerRoot)\SPTarkov.Server.Core.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="SemanticVersioning"><HintPath>$(SptServerRoot)\SemanticVersioning.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="WTT-ServerCommonLib"><HintPath>$(SptServerRoot)\user\mods\WTT-ServerCommonLib\WTT-ServerCommonLib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="MoreBotsServer"><HintPath>$(SptServerRoot)\user\mods\MoreBotsServer\MoreBotsServer.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="DeployServer" AfterTargets="Build" Condition="'$(DeployToLocalInstall)' == 'true'">
    <PropertyGroup>
      <DeployDir>$(SptServerRoot)\user\mods\$(AssemblyName)</DeployDir>
    </PropertyGroup>
    <MakeDir Directories="$(DeployDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DeployDir)" />
    <ItemGroup>
      <StaticModFiles Include="$(MSBuildProjectDirectory)\..\ServerModFiles\**\*" />
    </ItemGroup>
    <Copy SourceFiles="@(StaticModFiles)" DestinationFiles="@(StaticModFiles->'$(DeployDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
  </Target>

  <!-- Explicit packaging avoids racing solution builds and never deploys to a game install. -->
  <Target Name="PackageCombined" DependsOnTargets="Build">
    <PropertyGroup>
      <ModRoot>$(MSBuildProjectDirectory)\..</ModRoot>
      <CombinedZipPath>$(ModRoot)\$(ModForgeName)-$(ModVersion)-SPT41$(PackageNameSuffix).zip</CombinedZipPath>
      <CombinedTempDir>$(MSBuildProjectDirectory)\obj\CombinedPackage</CombinedTempDir>
      <CombinedClientDir>$(CombinedTempDir)\BepInEx\plugins\$(ModServerName)</CombinedClientDir>
      <CombinedPrepatchDir>$(CombinedTempDir)\BepInEx\patchers\LegArmorPrepatch</CombinedPrepatchDir>
      <CombinedServerDir>$(CombinedTempDir)\$(SptPackageServerDirectory)\user\mods\$(AssemblyName)</CombinedServerDir>
    </PropertyGroup>
    <MSBuild Projects="$(ModRoot)\LegArmorClient\LegArmorClient.csproj" Targets="Build" Properties="Configuration=$(Configuration);DeployToLocalInstall=false">
      <Output TaskParameter="TargetOutputs" ItemName="ClientBuildOutput" />
    </MSBuild>
    <MSBuild Projects="$(ModRoot)\LegArmorPrepatch\LegArmorPrepatch.csproj" Targets="Build" Properties="Configuration=$(Configuration);DeployToLocalInstall=false">
      <Output TaskParameter="TargetOutputs" ItemName="PrepatchBuildOutput" />
    </MSBuild>
    <RemoveDir Directories="$(CombinedTempDir)" />
    <MakeDir Directories="$(CombinedClientDir);$(CombinedPrepatchDir);$(CombinedServerDir)" />
    <Copy SourceFiles="@(ClientBuildOutput)" DestinationFolder="$(CombinedClientDir)" />
    <Copy SourceFiles="@(PrepatchBuildOutput)" DestinationFolder="$(CombinedPrepatchDir)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(CombinedServerDir)" />
    <ItemGroup>
      <CombinedStaticFiles Include="$(ModRoot)\ServerModFiles\**\*.json;$(ModRoot)\ServerModFiles\**\*.jsonc;$(ModRoot)\ServerModFiles\**\*.bundle" />
    </ItemGroup>
    <Copy SourceFiles="@(CombinedStaticFiles)" DestinationFiles="@(CombinedStaticFiles->'$(CombinedServerDir)\%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(CombinedTempDir)" DestinationFile="$(CombinedZipPath)" Overwrite="true" />
    <RemoveDir Directories="$(CombinedTempDir)" />
    <Message Text="Install package: $(CombinedZipPath)" Importance="high" />
  </Target>
</Project>
