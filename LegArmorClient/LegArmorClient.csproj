<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <RootNamespace>Manimal.LegArmor</RootNamespace>
    <AssemblyName>LegArmorClient</AssemblyName>
    <Nullable>disable</Nullable>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <Version>$(ModVersion)</Version>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="0Harmony"><HintPath>$(SptClientRoot)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(SptClientRoot)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="spt-common"><HintPath>$(SptClientRoot)\BepInEx\plugins\spt\spt-common.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="spt-reflection"><HintPath>$(SptClientRoot)\BepInEx\plugins\spt\spt-reflection.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="WTT-ClientCommonLib"><HintPath>$(SptClientRoot)\BepInEx\plugins\WTT-ClientCommonLib\WTT-ClientCommonLib.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityToolkit"><HintPath>$(SptClientRoot)\BepInEx\plugins\UnityToolkit\UnityToolkit.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ZLinq"><HintPath>$(SptClientRoot)\BepInEx\plugins\UnityToolkit\ZLinq.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Assembly-CSharp"><HintPath>$(SptManagedDirectory)\Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Comfort"><HintPath>$(SptManagedDirectory)\Comfort.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Comfort.Unity"><HintPath>$(SptManagedDirectory)\Comfort.Unity.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ItemComponent.Types"><HintPath>$(SptManagedDirectory)\ItemComponent.Types.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="ItemTemplate.Types"><HintPath>$(SptManagedDirectory)\ItemTemplate.Types.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Newtonsoft.Json"><HintPath>$(SptManagedDirectory)\Newtonsoft.Json.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sirenix.Serialization"><HintPath>$(SptManagedDirectory)\Sirenix.Serialization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Unity.TextMeshPro"><HintPath>$(SptManagedDirectory)\Unity.TextMeshPro.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(SptManagedDirectory)\UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.AssetBundleModule"><HintPath>$(SptManagedDirectory)\UnityEngine.AssetBundleModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(SptManagedDirectory)\UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.IMGUIModule"><HintPath>$(SptManagedDirectory)\UnityEngine.IMGUIModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.InputLegacyModule"><HintPath>$(SptManagedDirectory)\UnityEngine.InputLegacyModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.PhysicsModule"><HintPath>$(SptManagedDirectory)\UnityEngine.PhysicsModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.TextRenderingModule"><HintPath>$(SptManagedDirectory)\UnityEngine.TextRenderingModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(SptManagedDirectory)\UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>
  <Target Name="DeployClient" AfterTargets="Build" Condition="'$(DeployToLocalInstall)' == 'true'">
    <MakeDir Directories="$(SptClientRoot)\BepInEx\plugins\$(ModServerName)" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SptClientRoot)\BepInEx\plugins\$(ModServerName)" />
  </Target>
</Project>
